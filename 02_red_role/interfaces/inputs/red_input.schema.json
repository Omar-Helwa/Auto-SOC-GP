{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autosoc://red_role/interfaces/inputs/red_input/0.1.0",
  "title": "RedInput",
  "description": "The message the Red role accepts to produce one proposal. Derived from the orchestrator's round_request plus the detection and benign constraints. Red validates this on entry and emits an error_response (category missing_information / validation) if it is incomplete or malformed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "detection",
    "benign_constraints",
    "prompt_version",
    "output_contract_version"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Round/task id; echoed back in the proposal and any error."
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_id", "rule_version", "logic_summary"],
      "properties": {
        "detection_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "maxLength": 1000 },
        "logic_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Human-readable summary of what the detection matches. Red reasons about this, it does not execute it."
        }
      }
    },
    "benign_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_scenario_families", "max_workflow_steps", "allowed_actions"],
      "properties": {
        "allowed_scenario_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "admin_automation",
              "software_deployment",
              "it_maintenance",
              "developer_activity",
              "power_user_tooling",
              "backup_and_recovery",
              "security_tooling"
            ]
          }
        },
        "max_workflow_steps": { "type": "integer", "minimum": 1, "maximum": 10 },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "process_execution",
              "file_operation",
              "network_connection",
              "registry_operation",
              "scheduled_task",
              "script_execution",
              "account_operation",
              "service_operation"
            ]
          }
        },
        "forbidden_notes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional free-text guardrails the red context must honor."
        }
      }
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Which red prompt template version the orchestrator pins for this round."
    },
    "output_contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Which red_proposal contract version red must emit.",
      "const": "0.1.0"
    },
    "permitted_evidence_refs": {
      "type": "array",
      "description": "Evidence references red is explicitly allowed to use as context. References only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_type"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "evidence_type": {
            "type": "string",
            "enum": ["splunk_result", "reviewed_label", "telemetry"]
          },
          "provenance_ref": { "type": "string" }
        }
      }
    }
  }
}
