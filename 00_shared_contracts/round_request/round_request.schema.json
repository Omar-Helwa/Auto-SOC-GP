{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autosoc://contracts/round_request/0.1.0",
  "title": "RoundRequest",
  "description": "Everything the Orchestrator freezes to open one reproducible round: task id, detection, benign constraints, dataset, judge criteria and version references. The orchestrator derives the red_input from it. It must never contain proposals, evidence, matches, labels, or a verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "detection",
    "benign_constraints",
    "dataset",
    "criteria",
    "versions"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "Round/task identifier. It is also the round id: one task_id opens one round."
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_id", "rule_version", "logic_summary", "rule_language", "rule_text"],
      "properties": {
        "detection_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1, "description": "Version of the BASELINE rule." },
        "description": { "type": "string", "maxLength": 1000 },
        "logic_summary": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "Human-readable summary shown to red." },
        "rule_language": { "type": "string", "enum": ["splunk_spl"] },
        "rule_text": { "type": "string", "minLength": 1, "maxLength": 20000, "description": "The baseline rule. Given to blue and the platform, not to red." }
      }
    },
    "benign_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_scenario_families", "max_workflow_steps", "allowed_actions"],
      "description": "Same shape as red_input.benign_constraints.",
      "properties": {
        "allowed_scenario_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["admin_automation", "software_deployment", "it_maintenance", "developer_activity", "power_user_tooling", "backup_and_recovery", "security_tooling"]
          }
        },
        "max_workflow_steps": { "type": "integer", "minimum": 1, "maximum": 10 },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["process_execution", "file_operation", "network_connection", "registry_operation", "scheduled_task", "script_execution", "account_operation", "service_operation"]
          }
        },
        "forbidden_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_version", "evaluation_set_id"],
      "description": "Same shape as match_set.dataset. The evaluation set is frozen for the round.",
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "evaluation_set_id": { "type": "string", "minLength": 1 },
        "evaluation_set_checksum": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria_id", "criteria_version", "thresholds"],
      "description": "Judge acceptance criteria, frozen for the round. Red, blue and the orchestrator cannot change them.",
      "properties": {
        "criteria_id": { "type": "string", "minLength": 1 },
        "criteria_version": { "type": "string", "minLength": 1 },
        "thresholds": { "type": "object", "minProperties": 1, "description": "Judge-owned values; their keys are defined by the judge." }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red_prompt", "blue_prompt", "model_id", "contracts"],
      "description": "Version references not already carried by detection, dataset or criteria.",
      "properties": {
        "red_prompt": { "type": "string", "minLength": 1 },
        "blue_prompt": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_date": { "type": "string", "minLength": 1 },
        "contracts": { "type": "string", "minLength": 1, "description": "Shared contract version set used by the round." }
      }
    },
    "permitted_evidence_refs": {
      "type": "array",
      "description": "Evidence references red may use as context. References only.",
      "items": { "$ref": "autosoc://contracts/telemetry_evidence/evidence_reference/0.1.0" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts_per_step": { "type": "integer", "minimum": 1 },
        "step_timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "description": "Retry and timeout bounds, frozen so a replay behaves the same way. Defaults: 2 attempts, 300 seconds."
    }
  }
}
