{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autosoc://contracts/blue_proposal/0.1.0",
  "title": "BlueProposal",
  "description": "One bounded edit set to a detection rule, proposed by the Blue role to remove observed false positives while keeping the required attack detections. A proposal ONLY: it must never contain execution results, Splunk matches, labels, or an acceptance verdict, and it can never change the judge's criteria.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "proposal_id",
    "task_id",
    "prompt_version",
    "detection_under_test",
    "edits",
    "addressed_false_positives",
    "justification"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "0.1.0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique id for this proposal (UUID recommended)."
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Round/task identifier. Mirrors the blue input task_id."
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the blue prompt template used."
    },
    "detection_under_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_id", "rule_version"],
      "properties": {
        "detection_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1, "description": "The BASE rule version the edits apply to." }
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "Bounded list of rule edits, applied in order. 1..5 enforces the 'small edit' constraint.",
      "items": { "$ref": "#/$defs/rule_edit" }
    },
    "addressed_false_positives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "evidence_id values (from the blue input) of the false positives this proposal is meant to remove.",
      "items": { "type": "string", "minLength": 1 }
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Why the edits remove the false positives without hiding the required attacks."
    },
    "expected_effect": {
      "type": "string",
      "maxLength": 500,
      "description": "Hypothesis about the effect. NOT a measured result: the judge measures."
    },
    "reference_rules": {
      "type": "array",
      "maxItems": 10,
      "description": "Public reference rules retrieved to ground the edit (retrieval output, not evidence).",
      "items": { "$ref": "#/$defs/reference_rule" }
    },
    "evidence_references": {
      "type": "array",
      "description": "References to telemetry_evidence used. References ONLY, never raw evidence.",
      "items": { "$ref": "#/$defs/evidence_reference" }
    },
    "constraints_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["within_allowed_edits", "no_execution", "no_verdict", "no_judge_criteria_change"],
      "properties": {
        "within_allowed_edits": { "type": "boolean", "const": true },
        "no_execution": { "type": "boolean", "const": true },
        "no_verdict": { "type": "boolean", "const": true },
        "no_judge_criteria_change": { "type": "boolean", "const": true }
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 2000
    },
    "edited_rule": {
      "type": "object",
      "description": "Optional. The base rule with the edits applied, rendered by Blue for convenience (e.g. a ready-to-run Splunk search). Informational only: the platform compiles and runs the edits itself and the judge measures; consumers may ignore this field.",
      "additionalProperties": false,
      "required": ["format", "text"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["sigma", "spl"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    }
  },
  "$defs": {
    "rule_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "conditions", "reason"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["add_exclusion", "narrow_selection"],
          "description": "add_exclusion: new filter block, rule condition becomes '(old) and not filter'. narrow_selection: extra AND conditions inside an existing selection."
        },
        "target_selection": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Name of the existing selection to narrow. Required for narrow_selection, forbidden for add_exclusion."
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "Field conditions, combined with AND.",
          "items": { "$ref": "#/$defs/field_condition" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "narrow_selection" } } },
          "then": { "required": ["target_selection"] }
        },
        {
          "if": { "properties": { "operation": { "const": "add_exclusion" } } },
          "then": { "not": { "required": ["target_selection"] } }
        }
      ]
    },
    "field_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "modifier", "values"],
      "properties": {
        "field": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 64 },
        "modifier": {
          "type": "string",
          "enum": ["equals", "contains", "startswith", "endswith"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "description": "OR-ed values. No wildcards: '*' and '?' are rejected so an exclusion stays narrow.",
          "items": { "type": "string", "minLength": 3, "maxLength": 300, "pattern": "^[^*?]+$" }
        }
      }
    },
    "reference_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "title"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "type": "string", "maxLength": 100 }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_type": { "type": "string", "enum": ["splunk_result", "reviewed_label", "telemetry"] },
        "provenance_ref": { "type": "string" }
      },
      "description": "Same shape as 00_shared_contracts/telemetry_evidence/evidence_reference.schema.json."
    }
  }
}
